/* Utility-ish classes (so we don’t repeat styles everywhere) */
.bc-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 16px;
}

.bc-card {
  background: var(--bc-card);
  border: 1px solid var(--bc-border);
  border-radius: 16px;
}

.bc-card-pad {
  padding: 16px;
}

.bc-muted {
  color: var(--bc-muted);
}

.bc-faint {
  color: var(--bc-faint);
}

.bc-divider {
  border-top: 1px solid var(--bc-border);
}

/* Make buttons/inputs feel less “prototype” even before we build components */
button {
  cursor: pointer;
}

input,
select,
textarea {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.14);
  color: var(--bc-text);
  border-radius: 12px;
  padding: 10px 12px;
  outline: none;
}

input::placeholder,
textarea::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

a {
  color: inherit;
  text-decoration: none;
}

/* Fix native select dropdown list (Windows/Chrome white-on-white) */
select option {
  background: var(--bc-navy);
  color: var(--bc-white);
}

/* Kill double-tap-zoom tap swallowing + 300ms delay on all interactive elements */
button, a, select, input, [role="button"] {
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}
button {
  user-select: none;
  -webkit-user-select: none;
}
