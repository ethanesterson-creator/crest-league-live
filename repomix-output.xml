export function getSportRules(sport) {
  const k = key(sport);

  const aliases = {
    basketball: "hoop",
    bb: "hoop",
    hoops: "hoop",
  };

  const resolved = aliases[k] ?? k;
  return SPORT_RULES[resolved] ?? { label: resolved, clock: { enabled: false }, scoreButtons: [1], stats: [] };
}
